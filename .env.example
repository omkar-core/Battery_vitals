# MongoDB Atlas Connection
# Confirmed working format (Vercel + local):
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.bzbhymi.mongodb.net/BatteryVitals?retryWrites=true&w=majority&appName=Cluster0

# MQTT (HiveMQ Cloud) - server bridge credentials
MQTT_BROKER=5b9d87717c6c4e12a113c6eaa427b946.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=esp32_client
MQTT_PASSWORD=your_mqtt_password

# Public MQTT (for browser WebSocket - HiveMQ Cloud)
NEXT_PUBLIC_MQTT_BROKER=5b9d87717c6c4e12a113c6eaa427b946.s1.eu.hivemq.cloud
NEXT_PUBLIC_MQTT_USERNAME=web_client
NEXT_PUBLIC_MQTT_PASSWORD=your_web_password

# Gemini AI Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy...your_key_here

# Environment: development | production
NODE_ENV=development
