# .env.example - Template for environment variables
# Copy this to .env.local for local development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/batteryvitals

# MQTT Server (HiveMQ Cloud) - Server Side
MQTT_BROKER=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=esp32_client
MQTT_PASSWORD=your_password

# MQTT WebSocket (HiveMQ Cloud) - Client Side
NEXT_PUBLIC_MQTT_BROKER=xxxxxxxx.s1.eu.hivemq.cloud
NEXT_PUBLIC_MQTT_USERNAME=web_client
NEXT_PUBLIC_MQTT_PASSWORD=your_password

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Environment
NODE_ENV=production