# MongoDB Atlas Connection
# Get this from: MongoDB Atlas > Database > Connect > Drivers
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/battery_vital?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/battery_vital?retryWrites=true&w=majority

# Server Port
PORT=3000

# ESP32 API Key (for securing ESP32 connection)
ESP32_API_KEY=your_secret_key_here
