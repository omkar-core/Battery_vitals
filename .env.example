# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster.mongodb.net/BatteryVitals?retryWrites=true&w=majority&appName=Cluster0

# Server Port (local dev only — Vercel uses its own port)
PORT=3000

# Gemini AI Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy...your_key_here

# CORS Origins (comma-separated)
# For Vercel: include your Vercel deployment URL
CORS_ORIGINS=http://localhost:3000,https://battery-vitals-puce.vercel.app

# Environment: development | production
NODE_ENV=development
